DATABASE_URL="postgresql://copilot:copilot@localhost:5432/copilot?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# "claude" uses the Anthropic API (needs ANTHROPIC_API_KEY); "fake" is a deterministic stand-in for tests and offline dev.
LLM_PROVIDER="claude"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
# Per-user daily cap on model calls, so a leaked account can't run up the bill.
LLM_DAILY_LIMIT=150
# Comma-separated emails allowed to use real Claude. Empty = everyone. Set it on any public deployment.
REAL_LLM_EMAILS=""
# "worker" for a normal server; "on-demand" on serverless hosts like Vercel, where no poller can stay alive.
QUEUE_MODE="worker"
PORT=4100
